{
  "policyId": "org.openegiz.mine:abac_mine_policy",
  "entries": {
    "ADMIN_SYSTEM": {
      "subjects": {
        "nginx:ditto": {
          "type": "pre-authenticated"
        },
        "ditto:ditto": {
          "type": "pre-authenticated"
        }
      },
      "resources": {
        "thing:/": {
          "grant": ["READ", "WRITE"],
          "revoke": []
        },
        "policy:/": {
          "grant": ["READ", "WRITE"],
          "revoke": []
        },
        "message:/": {
          "grant": ["READ", "WRITE", "EXECUTE"],
          "revoke": []
        }
      }
    },
    "ROLE_FMS_DISPATCHER": {
      "subjects": {
        "role:fms_dispatcher": {
          "type": "authenticated"
        }
      },
      "resources": {
        "thing:/attributes": {
          "grant": ["READ"],
          "revoke": []
        },
        "thing:/features/dispatch": {
          "grant": ["READ", "WRITE"],
          "revoke": []
        },
        "thing:/features/shovel_assignment": {
          "grant": ["READ", "WRITE"],
          "revoke": []
        },
        "thing:/features/route_geometry": {
          "grant": ["READ", "WRITE"],
          "revoke": []
        },
        "thing:/features/electrical_grid": {
          "grant": ["READ"],
          "revoke": ["WRITE"]
        },
        "message:/inbox/messages/dispatch": {
          "grant": ["READ", "WRITE", "EXECUTE"],
          "revoke": []
        }
      }
    },
    "ROLE_GEOTECH_SAFETY_OFFICER": {
