        "thing:/features/piezometer_pressure": {
          "grant": ["READ", "WRITE"],
          "revoke": []
        },
        "thing:/features/dewatering_sump": {
          "grant": ["READ", "WRITE"],
          "revoke": []
        },
        "thing:/features/contingency_status": {
          "grant": ["READ", "WRITE"],
          "revoke": []
