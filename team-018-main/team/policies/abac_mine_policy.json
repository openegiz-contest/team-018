        "message:/inbox/messages/evacuate_bench": {
          "grant": ["READ", "WRITE", "EXECUTE"],
          "revoke": []
        }
      }
    },
    "ROLE_PLANT_METALLURGIST": {
      "subjects": {
        "role:plant_metallurgist": {
          "type": "authenticated"
        }
      },
      "resources": {
        "thing:/features/crusher_circuit": {
          "grant": ["READ", "WRITE"],
          "revoke": []
