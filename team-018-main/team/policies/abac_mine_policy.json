    "ROLE_AUTONOMOUS_PID_AGENT": {
      "subjects": {
        "role:autonomous_pid_agent": {
          "type": "authenticated"
        }
      },
      "resources": {
        "thing:/features/control_setpoints/properties/*": {
          "grant": ["READ", "WRITE"],
          "revoke": []
        },
        "thing:/features/kalman_adaptation": {
          "grant": ["READ", "WRITE"],
          "revoke": []
